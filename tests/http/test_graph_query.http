### ============================================================
### Graph Query Tools - HTTP test cases
### Prerequisites:
###   1. NEO4J_ENABLED=true, Neo4j running
###   2. ETL full sync completed (POST /admin/etl/trigger)
###   3. config.yaml: query_backend=graphiti, lookup_shortcut_enabled=false,
###      generic_template_enabled=false, l3_dag_min_confidence=0.99
###   4. uvicorn api.main:app --workers 4 --port 8080
### NOTE: Each test uses $timestamp in session_id to avoid history pollution
### ============================================================

@host = http://127.0.0.1:8080
@prefix = {{host}}/api/v1/ptp-agent


### ============================================================
### 1. search_knowledge_graph
### ============================================================

### 1a. search supplier
POST {{prefix}}/analyze
Content-Type: application/json

{
    "query": "用 search_knowledge_graph 工具搜索 SUP-001 的所有关联实体",
    "user_id": "graph_test",
    "session_id": "search-{{$timestamp}}"
}

### 1b. search material
POST {{prefix}}/analyze
Content-Type: application/json

{
    "query": "用 search_knowledge_graph 工具搜索物料 MAT-001 的所有采购记录",
    "user_id": "graph_test",
    "session_id": "search-mat-{{$timestamp}}"
}



POST {{host}}/api/v1/ptp-agent/analyze
Content-Type: application/json

{
    "query": "评估供应商 SUP-002 中兴通讯的绩效表现",
    "user_id": "analyst-001",
    "analysis_type": "supplier_performance"
}


# ============================================================
# ERP Analysis Agent - 环境变量模板
# 复制为 .env 后填入敏感凭证；其余项已是 settings.py 中的默认值，
# 修改后会通过 pydantic-settings 的 env_prefix 机制覆盖默认配置。
# ============================================================

# ---- 敏感凭证（二选一：明文 或 加密版本，不可同时设置） ----
#
# 方式一：明文（开发环境快速上手）
LLM_API_KEY=
NEO4J_PASSWORD=
POSTGRES_PASSWORD=
#
# 方式二：加密（生产推荐）
# 操作步骤：
#   1. 生成主密钥（只需一次）：
#        python -m config.crypto generate-key
#   2. 将主密钥保存到安全存储（CI Secret / 密钥管理服务），不要写入 .env
#   3. 加密各凭证：
#        ENCRYPTION_MASTER_KEY=<key> python -m config.crypto encrypt LLM_API_KEY
#        ENCRYPTION_MASTER_KEY=<key> python -m config.crypto encrypt NEO4J_PASSWORD
#        ENCRYPTION_MASTER_KEY=<key> python -m config.crypto encrypt POSTGRES_PASSWORD
#   4. 将输出的密文填入下方，并注释掉对应的明文行：
# LLM_API_KEY_ENCRYPTED=
# NEO4J_PASSWORD_ENCRYPTED=
# POSTGRES_PASSWORD_ENCRYPTED=
#
# 主密钥（不写入 .env，通过外部安全渠道注入）：
# ENCRYPTION_MASTER_KEY=

# ============================================================
# 应用全局（Settings, env_prefix=APP_）
# ============================================================
APP_APP_NAME=ERP Analysis Agent
APP_APP_VERSION=0.1.0
APP_DEBUG=false
APP_LANGUAGE=zh

# ============================================================
# LLM（LLMSettings, env_prefix=LLM_）
# ============================================================
LLM_PROVIDER=zhipu
LLM_MODEL=glm-4
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=30
LLM_MAX_RETRIES=3
# 是否读取系统代理（HTTP_PROXY/HTTPS_PROXY/NO_PROXY）；false=强制直连
LLM_USE_SYSTEM_PROXY=false

# ============================================================
# Neo4j 图数据库（Neo4jSettings, env_prefix=NEO4J_）
# ============================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=10

# ============================================================
# Chroma 向量数据库（ChromaSettings, env_prefix=CHROMA_）
# ============================================================
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=erp_ontology
CHROMA_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# PostgreSQL 关系数据库（PostgreSQLSettings, env_prefix=POSTGRES_）
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=eragent
POSTGRES_USERNAME=postgres
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# ============================================================
# 模拟数据生成（MockDataSettings, env_prefix=MOCK_DATA_）
# ============================================================
MOCK_DATA_RECORD_COUNT=500
MOCK_DATA_SEED=42

# ============================================================
# 分析任务（AnalysisSettings, env_prefix=ANALYSIS_）
# ============================================================
ANALYSIS_DEFAULT_TIME_RANGE_DAYS=30
ANALYSIS_MAX_TIME_RANGE_DAYS=365
ANALYSIS_RESPONSE_TIMEOUT_SECONDS=5.0

# ============================================================
# 三路匹配容差（ThreeWayMatchSettings, env_prefix=THREE_WAY_MATCH_）
# 复杂结构（supplier_tolerances/category_tolerances/amount_thresholds）
# 仍由 config.yaml 提供，不在此处覆盖
# ============================================================
THREE_WAY_MATCH_DEFAULT_TOLERANCE_PCT=5.0
THREE_WAY_MATCH_MAX_TOLERANCE_PCT=10.0

# ============================================================
# 付款合规（PaymentComplianceSettings, env_prefix=PAYMENT_COMPLIANCE_）
# ============================================================
PAYMENT_COMPLIANCE_EARLY_PAYMENT_THRESHOLD_DAYS=5

# ============================================================
# 供应商绩效基准（SupplierPerformanceBenchmarks, env_prefix=SUPPLIER_PERF_）
# ============================================================
SUPPLIER_PERF_OTIF_RATE=95.0
SUPPLIER_PERF_INVOICE_ACCURACY_RATE=99.0
SUPPLIER_PERF_QUALITY_PASS_RATE=98.0
SUPPLIER_PERF_PRICE_COMPLIANCE_RATE=98.0

# ============================================================
# 异常严重等级阈值（AnomalySeveritySettings, env_prefix=ANOMALY_SEVERITY_）
# ============================================================
ANOMALY_SEVERITY_HIGH_AMOUNT_THRESHOLD=500000.0
ANOMALY_SEVERITY_VARIANCE_HIGH_MULTIPLIER=2.0

# ============================================================
# 记忆管理（MemorySettings, env_prefix=MEMORY_）
# ============================================================
MEMORY_SHORT_TERM_MAX_MESSAGES=20
MEMORY_SHORT_TERM_SUMMARY_THRESHOLD=15
MEMORY_LONG_TERM_MAX_RETRIEVED=5

# ============================================================
# 日志（LoggingSettings, env_prefix=LOG_）
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_TRACE_ID=true

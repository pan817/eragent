# ============================================================
# ERP Analysis Agent - 环境变量模板
# 复制为 .env 后填入敏感凭证；其余项已是 settings.py 中的默认值，
# 修改后会通过 pydantic-settings 的 env_prefix 机制覆盖 YAML 和默认配置。
# 优先级：环境变量(.env) > config.yaml > settings.py 硬编码默认值
# ============================================================

# ---- 敏感凭证（二选一：明文 或 加密版本，不可同时设置） ----
#
# 方式一：明文（开发环境快速上手）
LLM_API_KEY=
NEO4J_PASSWORD=
POSTGRES_PASSWORD=
#
# 方式二：加密（生产推荐）
# 操作步骤：
#   1. 生成主密钥（只需一次）：
#        python -m config.crypto generate-key
#   2. 将主密钥保存到安全存储（CI Secret / 密钥管理服务），不要写入 .env
#   3. 加密各凭证：
#        ENCRYPTION_MASTER_KEY=<key> python -m config.crypto encrypt LLM_API_KEY
#        ENCRYPTION_MASTER_KEY=<key> python -m config.crypto encrypt NEO4J_PASSWORD
#        ENCRYPTION_MASTER_KEY=<key> python -m config.crypto encrypt POSTGRES_PASSWORD
#   4. 将输出的密文填入下方，并注释掉对应的明文行：
# LLM_API_KEY_ENCRYPTED=
# NEO4J_PASSWORD_ENCRYPTED=
# POSTGRES_PASSWORD_ENCRYPTED=
#
# 主密钥（不写入 .env，通过外部安全渠道注入）：
# ENCRYPTION_MASTER_KEY=



# ============================================================
# 应用全局（Settings, env_prefix=APP_）
# ============================================================
# 业务时区：全链路（代码 / PostgreSQL 会话 / LangGraph checkpointer）统一使用。
# IANA 时区名，默认 Asia/Shanghai。改动后进程需重启。
# APP_TIMEZONE=Asia/Shanghai


# ============================================================
# LLM（LLMSettings, env_prefix=LLM_）
# ============================================================
LLM_PROVIDER=qwen
LLM_MODEL=qwen3-max
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1


# ============================================================
# Neo4j 图数据库（Neo4jSettings, env_prefix=NEO4J_）
# ============================================================
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=10



# ============================================================
# PostgreSQL 关系数据库（PostgreSQLSettings, env_prefix=POSTGRES_）
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=eragent
POSTGRES_USERNAME=dev


# ============================================================
# 异步分析接口（AsyncAnalysisSettings, env_prefix=ASYNC_ANALYSIS_）
# ============================================================
# SSE 事件总线后端：
#   memory  —— 进程内 asyncio.Queue，仅适用于 uvicorn --workers=1
#   redis   —— Redis Pub/Sub + 环形缓冲，uvicorn --workers>1 多进程部署必须
# 多 worker 下如果仍用 memory，POST / GET /events 落在不同 worker 会导致
# SSE 只能看到心跳、永远收不到业务事件（lifespan 启动时会打 WARNING）。
ASYNC_ANALYSIS_EVENT_BACKEND=memory

# 仅 event_backend=redis 时生效；格式 redis://[:password@]host:port/db
ASYNC_ANALYSIS_REDIS_URL=redis://localhost:6379/0

# Redis key 前缀，多实例部署共享同一 Redis 时用此项做命名空间隔离
ASYNC_ANALYSIS_REDIS_KEY_PREFIX=eragent:events

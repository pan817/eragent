// ERP Agent - Synchronous Analyze Path (clean TB layout)
// 布局策略：所有 constraint=true,由 dot 自然推导层级。
// 核心链 Client→API→Orchestrator→(DAG/ReAct)→基础设施→外部 从上到下。
// IntentRouter 作为分支嵌入 Orchestrator 右侧。
// Render: dot -Tpng -Gdpi=150 arch_sync.dot -o arch_sync.png
digraph eragent_sync {
    rankdir=TB;
    nodesep=0.3;
    ranksep=0.5;
    graph [fontname="Helvetica", fontsize=14, labelloc="t",
           label="eragent — 同步分析路径 (POST /analyze)"];
    node  [fontname="Helvetica", fontsize=10, style="rounded,filled",
           fillcolor="white", color="#555555"];
    edge  [fontname="Helvetica", fontsize=9, color="#444444"];

    // ── ① Client ────────────────────────────────────────────────
    subgraph cluster_client {
        label="① 客户端"; penwidth=1.5;
        style="rounded,filled"; fillcolor="#FFFEF7"; color="#D4B886";
        cli_user [label="POST /analyze\n{query, user_id,\nsession_id, output_mode}",
                  shape=box, fontsize=11];
    }

    // ── ② API ──────────────────────────────────────────────────
    subgraph cluster_api {
        label="② API 入口"; penwidth=1.5;
        style="rounded,filled"; fillcolor="#E3F0FF"; color="#7FA7D4";
        api_route [label="api.routes.analyze\n.analyze()", shape=cds, fontsize=11];
    }

    // ── ③ Orchestrator 主干 ──────────────────────────────────
    subgraph cluster_orch {
        label="③ Orchestrator.analyze 编排步骤"; penwidth=1.5;
        style="rounded,filled"; fillcolor="#FFFADD"; color="#C9A96E";
        o_start   [label="start_run\n(trace_id)", shape=box, fontsize=11];
        o_ctx     [label="0. 短期记忆上下文", shape=box, fontsize=11];
        o_refres  [label="1. 指代消解", shape=box, fontsize=11];
        o_route   [label="2. IntentRouter.route",
                   shape=box, fontsize=12, fillcolor="#FFF4B8"];
        o_early   [label="2.5 早退\nMETA / CHITCHAT",
                   shape=box, fontsize=9, fillcolor="#FFE4E1"];
        o_params  [label="3. 合并参数 + time_range", shape=box, fontsize=11];
        o_enrich  [label="4. 实体校验 + 级联补充", shape=box, fontsize=11];
        o_decide  [label="5. 路由决策\nDAG vs ReAct",
                   shape=box, fontsize=12, fillcolor="#FFF3D6"];
        o_persist [label="6. 持久化结果", shape=box, fontsize=11];
    }

    // ── ④ IntentRouter 三级 ─────────────────────────────────
    subgraph cluster_router {
        label="④ IntentRouter 三级"; penwidth=1.5;
        style="rounded,filled"; fillcolor="#FFF9E0"; color="#C9A96E";
        r_bypass [label="bypass\n(CHITCHAT/META/RECALL)", shape=box];
        r_l1     [label="L1 关键词", shape=box];
        r_l2     [label="L2 Chroma 语义", shape=box];
        r_l3     [label="L3 LLM (llm_fast)", shape=box];
    }

    // ── ⑤ DAG ─────────────────────────────────────────────────
    subgraph cluster_dag {
        label="⑤ DAG 执行路径"; penwidth=1.5;
        style="rounded,filled"; fillcolor="#E8F5E9"; color="#6FA87C";
        d_load   [label="load_dag_template", shape=box, fontsize=11];
        d_valid  [label="DAGValidator", shape=box];
        d_exec   [label="DAGExecutor.execute\n并行 gather",
                  shape=box, fontsize=12, fillcolor="#C8E6C9"];
        d_task   [label="单任务 = @tool", shape=box];
        d_report [label="ReportAgent", shape=box, fontsize=11];
        d_case   [label="case_store", shape=box];
    }

    // ── ⑥ ReAct ───────────────────────────────────────────────
    subgraph cluster_react {
        label="⑥ ReAct 执行路径"; penwidth=1.5;
        style="rounded,filled"; fillcolor="#F1F8E9"; color="#8EB56E";
        a_agent [label="P2PAgent.run", shape=box, fontsize=11];
        a_graph [label="create_agent (LangGraph)\n+ MemoryMW + TimingMW\n+ PostgresSaver",
                 shape=box, fontsize=11];
        a_loop  [label="ReAct 循环\nLLM ↔ tool_call",
                 shape=box, fontsize=12, fillcolor="#DCEDC8"];
        a_tools [label="19 个 @tool\nquery / run / analyze\ncalculate / check",
                 shape=box, fontsize=11];
        a_rules [label="rules/\n4 条业务规则", shape=box];
        a_repo  [label="P2PRepository", shape=box];
    }

    // ── ⑦ 基础设施 ─────────────────────────────────────────────
    subgraph cluster_infra {
        label="⑦ 基础设施"; fontsize=10;
        style="rounded,filled"; fillcolor="#F5F5F5"; color="#AAAAAA";
        i_ltm      [label="LongTermMemory", shape=box, fontsize=9];
        i_check    [label="PostgresSaver\ncheckpointer", shape=box, fontsize=9];
        i_timing   [label="TimingMiddleware", shape=box, fontsize=9];
        i_store    [label="trace_store", shape=box, fontsize=9];
        i_ontology [label="OntologyReasoner\n(SWRL)", shape=box, fontsize=9];
    }

    // ── ⑧ 外部 ─────────────────────────────────────────────────
    subgraph cluster_ext {
        label="⑧ 外部系统"; fontsize=10;
        style="rounded,filled"; fillcolor="#EDE7F6"; color="#B8A9D1";
        e_pg       [label="PostgreSQL", shape=cylinder, fontsize=9];
        e_chroma   [label="Chroma", shape=cylinder, fontsize=9];
        e_owl      [label="p2p.owl", shape=note, fontsize=9];
        e_llm_main [label="LLM 主模型", shape=component, fillcolor="#F3E5F5", fontsize=9];
        e_llm_fast [label="LLM 小模型", shape=component, fillcolor="#F3E5F5", fontsize=9];
    }

    // ── 图例 ────────────────────────────────────────────────────
    subgraph cluster_legend {
        label="图例"; fontsize=9;
        style="rounded,dashed"; color="#999999";
        lg_a [label="", shape=plain]; lg_b [label="", shape=plain];
        lg_c [label="", shape=plain]; lg_d [label="", shape=plain];
        lg_e [label="", shape=plain]; lg_f [label="", shape=plain];
        lg_a -> lg_b [label="主请求", color="#D32F2F", penwidth=2.2];
        lg_c -> lg_d [label="同步", color="#444444"];
        lg_e -> lg_f [label="观测", color="#888888", style="dotted"];
    }

    // ─────────────────────────────────────────────────────────────
    //                       边 (constraint=true 默认)
    // ─────────────────────────────────────────────────────────────

    // 主干 (红粗线)
    cli_user  -> api_route  [color="#D32F2F", penwidth=2.2, weight=10];
    api_route -> o_start    [color="#D32F2F", penwidth=2.2, weight=10];
    o_start   -> o_ctx      [color="#D32F2F", penwidth=2.2, weight=10];
    o_ctx     -> o_refres   [color="#D32F2F", penwidth=2.2, weight=10];
    o_refres  -> o_route    [color="#D32F2F", penwidth=2.2, weight=10];
    o_route   -> o_early    [color="#444444", style="dashed", label="bypass"];
    o_route   -> o_params   [color="#D32F2F", penwidth=2.2, weight=10, label="ANALYSIS"];
    o_params  -> o_enrich   [color="#D32F2F", penwidth=2.2, weight=10];
    o_enrich  -> o_decide   [color="#D32F2F", penwidth=2.2, weight=10];

    // 分流
    o_decide -> d_exec  [color="#D32F2F", penwidth=2.2, weight=6, label="L1/L2"];
    o_decide -> a_agent [color="#D32F2F", penwidth=2.2, weight=6, label="L3"];

    // 早退 (次要)
    o_early -> o_persist [color="#444444", style="dashed", label="不写库"];

    // IntentRouter 三级 (侧枝,低权重让它排到右侧)
    o_route  -> r_bypass [color="#444444", weight=1];
    r_bypass -> r_l1     [color="#444444", label="未命中", weight=1];
    r_l1     -> r_l2     [color="#444444", label="未命中", weight=1];
    r_l2     -> r_l3     [color="#444444", label="未命中", weight=1];

    // DAG 内部
    d_load  -> d_valid [color="#444444"];
    d_valid -> d_exec  [color="#444444"];
    d_exec  -> d_task  [color="#444444", label="并行"];
    d_exec  -> d_report [color="#444444", label="汇总"];
    d_exec  -> d_case  [color="#444444", style="dashed"];

    // ReAct 内部
    a_agent -> a_graph [color="#444444"];
    a_graph -> a_loop  [color="#444444"];
    a_loop  -> a_tools [color="#444444", label="tool_call"];
    a_tools -> a_rules [color="#444444"];
    a_tools -> a_repo  [color="#444444"];

    // 执行完成 → 持久化
    d_report -> o_persist [color="#444444"];
    a_graph  -> o_persist [color="#444444"];

    // Orchestrator 读写基础设施 (不加 constraint=false,让 dot 把 infra 自然下拉)
    o_ctx     -> i_check [color="#444444", label="读历史"];
    a_graph   -> i_check [color="#444444", label="读写短期"];
    o_persist -> i_ltm   [color="#444444", label="save_report"];

    // 可观测性 (灰点线)
    o_start  -> i_timing [color="#888888", style="dotted"];
    d_exec   -> i_timing [color="#888888", style="dotted"];
    a_loop   -> i_timing [color="#888888", style="dotted"];
    i_timing -> i_store  [color="#888888", style="dotted"];

    // LLM 调用
    r_l3     -> e_llm_fast [color="#444444", label="意图"];
    d_report -> e_llm_fast [color="#444444", label="报告"];
    a_loop   -> e_llm_main [color="#444444", label="tool calling"];

    // 规则 → 本体
    a_rules -> i_ontology [color="#444444", style="dashed", label="SWRL"];

    // 基础设施 → 外部
    i_check    -> e_pg     [color="#444444"];
    i_ltm      -> e_pg     [color="#444444"];
    i_ltm      -> e_chroma [color="#444444"];
    i_store    -> e_pg     [color="#888888", style="dotted"];
    a_repo     -> e_pg     [color="#444444"];
    i_ontology -> e_owl    [color="#444444"];
    r_l2       -> e_chroma [color="#444444", label="intent_seeds"];
}

// ERP Agent - Asynchronous Analyze Path (clean TB layout)
// 布局策略：所有 constraint=true,由 dot 自然推导层级。
// 核心链 Client→API→TaskRegistry→Orchestrator→EventBus→(回 API SSE)→外部 从上到下。
// 生命周期(虚线淡化)作为次要分支,右侧。
// Render: dot -Tpng -Gdpi=150 arch_async.dot -o arch_async.png
digraph eragent_async {
    rankdir=TB;
    nodesep=0.3;
    ranksep=0.5;
    graph [fontname="Helvetica", fontsize=14, labelloc="t",
           label="eragent — 异步分析路径 (POST /analyze/async + SSE)"];
    node  [fontname="Helvetica", fontsize=10, style="rounded,filled",
           fillcolor="white", color="#555555"];
    edge  [fontname="Helvetica", fontsize=9, color="#444444"];

    // ── ① 客户端 ────────────────────────────────────────────────
    subgraph cluster_client {
        label="① 客户端 (三条并行连接)"; penwidth=1.5;
        style="rounded,filled"; fillcolor="#FFFEF7"; color="#D4B886";
        c_submit [label="POST /analyze/async\n→ 202 {trace_id}", shape=box, fontsize=11];
        c_stream [label="GET events (SSE)", shape=box, fontsize=11];
        c_poll   [label="GET tasks/{id}\n(查结果)", shape=box, fontsize=11];
    }

    // ── ② API ──────────────────────────────────────────────────
    subgraph cluster_api {
        label="② API 入口 (analyze_async.py)"; penwidth=1.5;
        style="rounded,filled"; fillcolor="#E3F0FF"; color="#7FA7D4";
        a_submit [label="POST /analyze/async", shape=cds, fontsize=11];
        a_sse    [label="GET events\nStreamingResponse SSE",
                  shape=cds, fontsize=11, fillcolor="#BBDEFB"];
        a_status [label="GET tasks/{id}", shape=cds, fontsize=11];
    }

    // ── ③ TaskRegistry ─────────────────────────────────────────
    subgraph cluster_registry {
        label="③ TaskRegistry (core.tasks.registry)"; penwidth=1.5;
        style="rounded,filled"; fillcolor="#FFF3D6"; color="#C9A96E";
        t_submit  [label="submit()\n产出 trace_id\n入 runner 队列",
                   shape=box, fontsize=12, fillcolor="#FFE0B2"];
        t_entry   [label="TaskEntry\n(状态 + 缓存)", shape=box];
        t_runner  [label="后台 runner\n并发 + 超时 + sweep",
                   shape=box, fontsize=12, fillcolor="#FFE0B2"];
        t_analyze [label="调用 Orchestrator.analyze()", shape=box, fontsize=11];
        t_status  [label="get_status / get_result", shape=box];
    }

    // ── ④ Orchestrator ────────────────────────────────────────
    subgraph cluster_orch {
        label="④ Orchestrator (后台执行)"; penwidth=1.5;
        style="rounded,filled"; fillcolor="#FFFADD"; color="#C9A96E";
        o_run   [label="Orchestrator.analyze()\n(同步路径共用实现)",
                 shape=box, fontsize=12, fillcolor="#FFF4B8"];
        o_stage [label="_publish_stage_safe()", shape=box];
        o_flush [label="trace_flush_barrier", shape=box, fontsize=9];
    }

    // ── ⑤ EventBus ────────────────────────────────────────────
    subgraph cluster_bus {
        label="⑤ EventBus (可切换后端)"; penwidth=1.5;
        style="rounded,filled"; fillcolor="#FFF9E0"; color="#C9A96E";
        b_publish [label="publish_stage()\nintent_resolved /\ndag_planned /\ntool_call_* /\nreport_generated",
                   shape=box, fontsize=10];
        b_iface   [label="EventBus 抽象\npublish / subscribe",
                   shape=box, fontsize=12, fillcolor="#FFF59D"];
        b_mem     [label="MemoryEventBus\n(asyncio.Queue)", shape=box, fontsize=9];
        b_redis   [label="RedisEventBus\n(PUB/SUB + buffer)", shape=box, fontsize=9];
    }

    // ── ⑥ 生命周期 (虚线次要) ─────────────────────────────
    subgraph cluster_lifecycle {
        label="⑥ 启动期 (仅首次)"; fontsize=9;
        style="rounded,dashed"; color="#AAAAAA"; fillcolor="#FAFAFA";
        l_check    [label="event_backend 匹配 workers\n(fail-fast)", shape=box, fontsize=8];
        l_bus_init [label="init_event_bus", shape=box, fontsize=8];
        l_reg_init [label="init_task_registry\n+ recover_on_startup", shape=box, fontsize=8];
    }

    // ── ⑦ 持久化与观测 ─────────────────────────────────────
    subgraph cluster_obs {
        label="⑦ 持久化与观测"; fontsize=10;
        style="rounded,filled"; fillcolor="#F5F5F5"; color="#AAAAAA";
        p_chat  [label="ChatRepository", shape=box, fontsize=9];
        p_trace [label="trace_store", shape=box, fontsize=9];
        p_chkpt [label="PostgresSaver", shape=box, fontsize=9];
    }

    // ── ⑧ 外部 ─────────────────────────────────────────────────
    subgraph cluster_ext {
        label="⑧ 外部系统"; fontsize=10;
        style="rounded,filled"; fillcolor="#EDE7F6"; color="#B8A9D1";
        e_redis [label="Redis\n(多 worker 必选)", shape=cylinder, fontsize=9];
        e_pg    [label="PostgreSQL", shape=cylinder, fontsize=9];
    }

    // ── 图例 ────────────────────────────────────────────────────
    subgraph cluster_legend {
        label="图例"; fontsize=9;
        style="rounded,dashed"; color="#999999";
        lg_a [label="", shape=plain]; lg_b [label="", shape=plain];
        lg_c [label="", shape=plain]; lg_d [label="", shape=plain];
        lg_e [label="", shape=plain]; lg_f [label="", shape=plain];
        lg_g [label="", shape=plain]; lg_h [label="", shape=plain];
        lg_a -> lg_b [label="主请求", color="#D32F2F", penwidth=2.2];
        lg_c -> lg_d [label="同步", color="#444444"];
        lg_e -> lg_f [label="异步/SSE", color="#1976D2", style="dashed"];
        lg_g -> lg_h [label="观测", color="#888888", style="dotted"];
    }

    // ─────────────────────────────────────────────────────────────
    //                       边 (constraint=true 默认)
    // ─────────────────────────────────────────────────────────────

    // 1) 提交任务 (红粗线,主干)
    c_submit -> a_submit [color="#D32F2F", penwidth=2.2, weight=10];
    a_submit -> t_submit [color="#D32F2F", penwidth=2.2, weight=10, label="submit()"];
    t_submit -> t_entry  [color="#444444", weight=5];

    // 2) 后台 runner 异步执行
    t_submit  -> t_runner  [color="#1976D2", style="dashed", label="入队", weight=5];
    t_runner  -> t_analyze [color="#1976D2", style="dashed", weight=5];
    t_analyze -> o_run     [color="#D32F2F", penwidth=2.2, weight=10];
    t_runner  -> t_entry   [color="#444444", style="dashed", label="更新状态"];

    // 3) Orchestrator 发布阶段事件 → EventBus
    o_run     -> o_stage   [color="#444444", weight=5];
    o_stage   -> b_publish [color="#1976D2", style="dashed", label="publish_stage", weight=5];
    b_publish -> b_iface   [color="#1976D2", style="dashed", weight=5];
    b_iface   -> b_mem     [color="#1976D2", style="dashed", label="memory"];
    b_iface   -> b_redis   [color="#1976D2", style="dashed", label="redis"];

    // 4) SSE 路径
    c_stream -> a_sse     [color="#D32F2F", penwidth=2.2, weight=5];
    a_sse    -> b_iface   [color="#1976D2", style="dashed", label="subscribe"];
    b_iface  -> a_sse     [color="#1976D2", style="dashed", label="stage 事件"];

    // 5) 轮询最终结果
    c_poll   -> a_status [color="#D32F2F", penwidth=2.2, weight=5];
    a_status -> t_status [color="#444444"];
    t_status -> t_entry  [color="#444444"];
    a_status -> p_chat   [color="#444444", label="结果补齐"];

    // 6) 启动期 (淡灰虚线)
    l_check    -> l_bus_init [color="#AAAAAA", style="dashed"];
    l_bus_init -> l_reg_init [color="#AAAAAA", style="dashed"];
    l_bus_init -> b_iface    [color="#AAAAAA", style="dashed", label="注入"];
    l_reg_init -> t_submit   [color="#AAAAAA", style="dashed", label="装配"];

    // 7) trace flush + 观测写入
    o_run   -> o_flush [color="#888888", style="dotted"];
    o_flush -> p_trace [color="#888888", style="dotted"];
    p_trace -> e_pg    [color="#888888", style="dotted"];

    // 8) 短期记忆 + chat 持久化
    o_run   -> p_chkpt [color="#444444", label="短期记忆"];
    p_chkpt -> e_pg    [color="#444444"];
    p_chat  -> e_pg    [color="#444444"];

    // 9) TaskRegistry 状态持久化
    t_entry -> e_pg [color="#444444", style="dashed", label="跨进程"];

    // 10) RedisEventBus → Redis
    b_redis -> e_redis [color="#1976D2", style="dashed"];
}
